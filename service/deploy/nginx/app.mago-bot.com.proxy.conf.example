# API Mago Bot — explicit public assets.
# Keep this regex in the aaPanel extension include before any generic image
# location, otherwise the webroot can return 404 for FastAPI-served assets.
location ~ ^/(brand-logo(-ui)?\.png|favicon\.ico|mago-hero\.png|mago-cta-human\.png|share-card(-ui)?\.png|public-app\.js)$ {
    proxy_pass http://127.0.0.1:4349;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
}

# API Mago Bot customer portal and product API.
location / {
    proxy_pass http://127.0.0.1:4349;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 60s;
    proxy_send_timeout 60s;
}
