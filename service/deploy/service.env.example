LICENSE_APP_NAME=wp-api
LICENSE_PUBLIC_BASE_URL=https://app.mago-bot.com
LICENSE_OWNER_EMAIL=admin@mago-bot.com
LICENSE_OWNER_PASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
LICENSE_OWNER_NAME=Mago Bot Admin
LICENSE_ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM_ADMIN_TOKEN
LICENSE_PANEL_SECRET=CHANGE_ME_LONG_RANDOM_PANEL_SECRET
LICENSE_DB_NAME=platform_db
LICENSE_DB_USER=platform_user
LICENSE_DB_PASSWORD=CHANGE_ME_LONG_RANDOM_DB_PASSWORD
LICENSE_DATABASE_URL=postgresql+psycopg://platform_user:CHANGE_ME_LONG_RANDOM_DB_PASSWORD@platform-db:5432/platform_db
WEB_CONCURRENCY=2

# New control-plane security secrets — generate unique values for production.
PLATFORM_SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS
PLATFORM_SECRET_KEY=CHANGE_ME_FERNET_KEY
METRICS_TOKEN=CHANGE_ME_32_PLUS_RANDOM_CHARACTERS

# Official Meta Cloud API adapter.
META_GRAPH_BASE_URL=https://graph.facebook.com
META_GRAPH_API_VERSION=v26.0
META_SYSTEM_USER_TOKEN=CHANGE_ME_META_SYSTEM_USER_TOKEN
META_APP_SECRET=CHANGE_ME_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=CHANGE_ME_META_WEBHOOK_VERIFY_TOKEN
META_HTTP_TIMEOUT=20

# Evolution compatibility adapter. Keep internal; do not market as official API.
EVOLUTION_INTERNAL_URL=http://evolution-api:8080
EVOLUTION_API_KEY=CHANGE_ME_EVOLUTION_API_KEY
EVOLUTION_HTTP_TIMEOUT=20

# Durable outgoing webhook worker.
WEBHOOK_MAX_ATTEMPTS=10
WEBHOOK_POLL_SECONDS=2

# Keep false in production; apply service/sql/migrations explicitly.
PLATFORM_AUTO_CREATE_SCHEMA=false

# Production must remain true. Canary on localhost may set false only for smoke tests.
PLATFORM_COOKIE_SECURE=true

# Exclusivo para staging/smoke; mantenha false ou ausente em produção.
ALLOW_DRY_RUN_PROVIDER=false

# Owner WhatsApp welcome worker — somente após integração Meta conectada e opt-in comprovado
OWNER_WELCOME_POLL_SECONDS=5
OWNER_WELCOME_MAX_ATTEMPTS=5
# ALLOW_DRY_RUN_PROVIDER deve permanecer false em produção

# MFA: enrolar primeiro; habilitar enforcement somente após confirmar recovery codes do operador.
MFA_ENFORCE_PLATFORM=false
MFA_STEP_UP_TTL_SECONDS=600
MFA_ISSUER=Mago Bot
